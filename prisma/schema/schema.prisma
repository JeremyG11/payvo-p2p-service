generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Customer {
  id              String   @id @default(uuid())

  userId          String   @unique
  totalOrders     Int      @default(0)
  completedOrders Int      @default(0)
  rating          Decimal  @db.Decimal(3, 2) @default(0.0)


  orders          Order[]
  disputes        Dispute[] @relation("CustomerDisputes")

  @@index([userId])
}

model Agent {
  id                 String   @id @default(uuid())
  userId             String   @unique
  totalOrders        Int      @default(0)
  completedOrders    Int      @default(0)
  commissionRate     Decimal  @db.Decimal(5, 2) @default(0.0)
  rating             Decimal  @db.Decimal(3, 2) @default(0.0)

  balances           Balance[]
  ads                Ad[]
  orders             Order[]
  disputes           Dispute[] @relation("AgentDisputes")

  @@index([userId])
}
