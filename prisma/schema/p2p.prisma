model SupportedPaymentMethod {
  id                      String               @id @default(uuid())
  type                    PaymentMethodType
  method                  String               
  currency                FiatCurrency
  isActive                Boolean              @default(true)
  logo                    String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  userPaymentMethods      UserPaymentMethod[]
  rates                   FiatCryptoRate[]

  @@unique([method, currency])
  @@index([type])
  @@index([method])
  @@index([currency])
  @@index([isActive])
}

model UserPaymentMethod {
  id                        String           @id @default(uuid())
  userId                    String            
  supportedPaymentMethodId  String
  isDefault                 Boolean          @default(false)
  userSpecificDetails       Json?            

  mpesaKenya                MPesaKenya?
  cbe                       Cbe?
  telebirr                  TeleBirr?

  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  supportedPaymentMethod  SupportedPaymentMethod @relation(fields: [supportedPaymentMethodId], references: [id], onDelete: Cascade)

  @@unique([userId, supportedPaymentMethodId])
  @@index([userId])
}

model MPesaKenya {
  id                 String           @id @default(uuid())
  phoneNumber        String           @unique
  accountName        String?
  
  userPaymentMethod  UserPaymentMethod @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  @@map("mpesa_kenya")
}

model Cbe {
  id                 String           @id @default(uuid())
  accountNumber      String           @unique
  accountName        String
  
  userPaymentMethod  UserPaymentMethod @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  @@map("cbe")
}

model TeleBirr {
  id                 String           @id @default(uuid())
  phoneNumber        String           @unique
  accountName        String?
  
  userPaymentMethod  UserPaymentMethod @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  @@map("telebirr")
}

model FiatCryptoRate {
  id                 String             @id @default(uuid())
  source             Source
  fiatCurrency       FiatCurrency
  cryptoCurrency     CryptoCurrency     @default(USDT)
  rateType           RateType
  paymentMethodId    String?            
  rawRate            String            
  adjustedRate       String?           
  marginPercentage   String?           
  volumeAvailable    String?           
  minLimit           String?           
  maxLimit           String?           
  adId               String?         
  isActive           Boolean            @default(true)
  
  fetchedAt          DateTime           @default(now())       
  expiresAt          DateTime?       
  createdAt          DateTime           @default(now())       
  updatedAt          DateTime           @updatedAt

  paymentMethod      SupportedPaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([source])
  @@index([fiatCurrency, cryptoCurrency])
  @@index([fiatCurrency, cryptoCurrency, paymentMethodId, rateType])
  @@index([source, fetchedAt])
}

 