model SupportedPaymentMethod {
  id                    String                @id @default(uuid())
  category              PaymentMethodCategory 
  provider              String 
  displayName           String
  currency              FiatCurrency
  isActive              Boolean               @default(true)
  logoUrl               String?

  userPaymentMethods    UserPaymentMethod[]
  rates                 FiatCryptoRate[] 

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([provider, currency])
  @@index([category])
}

model UserPaymentMethod {
  id                        String   @id @default(uuid())
  userId                    String
  supportedPaymentMethodId  String
  isDefault                 Boolean  @default(false)
  details                   Json     

  mpesaKenya                MPesaKenya?
  cbe                       Cbe?
  telebirr                  TeleBirr?

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  ads                       AdsOnPaymentMethods[]

  supportedPaymentMethod    SupportedPaymentMethod @relation(fields: [supportedPaymentMethodId], references: [id], onDelete: Restrict)
  ordersAsPaymentMethod     Order[]      @relation("ordersAsPaymentMethod")

  @@index([userId])
}

model MPesaKenya {
  id                 String             @id @default(uuid())
  phoneNumber        String             @unique
  accountName        String?
  currency           FiatCurrency       @default(KES)
  displayName        String?            @default("M-Pesa Kenya")
  userPaymentMethod  UserPaymentMethod  @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("mpesa_kenya")
}

model Cbe {
  id                 String           @id @default(uuid())
  accountNumber      String           @unique
  accountName        String
  displayName        String?          @default("Commercial Bank of Ethiopia")
  currency           FiatCurrency     @default(ETB)

  userPaymentMethod  UserPaymentMethod @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  @@map("cbe")
}

model TeleBirr {
  id                 String           @id @default(uuid())
  phoneNumber        String           @unique
  accountName        String?
  currency           FiatCurrency     @default(ETB)
  displayName        String?          @default("Tele Birr")

  userPaymentMethod  UserPaymentMethod @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  @@map("telebirr")
}

model FiatCryptoRate {
  id                                String       @id @default(uuid())
  advNo                             String
  source                            Source
  paymentMethodProvider             String
  fiatCurrency                      FiatCurrency
  cryptoCurrency                    CryptoCurrency
  adType                            AdType

  rawRate                           Decimal      @db.Decimal(18, 8)
  volumeAvailable                   Decimal      @db.Decimal(36, 18)
  minLimit                          Decimal      @db.Decimal(18, 2)
  maxLimit                          Decimal      @db.Decimal(18, 2)
  isActive                          Boolean      @default(true)

  fetchedAt                         DateTime     @default(now())
  expiresAt                         DateTime?
  createdAt                         DateTime     @default(now())
  updatedAt                         DateTime     @updatedAt

  supportedPaymentMethodId          String?
  supportedPaymentMethod            SupportedPaymentMethod? @relation(fields: [supportedPaymentMethodId], references: [id])

  ads                               Ad[]
  

  @@index([fiatCurrency, cryptoCurrency, adType])
}

 
model Dispute {
  id                  String     @id @default(uuid())
  orderId             String     @unique
  customerId          String?
  agentId             String?
  
  initiatedByUserId   String
  
  resolvedByAdminId   String?

  reason              String
  status              String     @default("OPEN")
  resolution          String?
  resolvedAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  order               Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer            Customer?  @relation("CustomerDisputes", fields: [customerId], references: [id])
  agent               Agent?     @relation("AgentDisputes", fields: [agentId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([initiatedByUserId])
}

 
 model PricingConfig {
  id                    String   @id @default(uuid())
  corridor              String   // e.g., "USD-ETB", "USD-SSP"
  adType                AdType   
  margin                Decimal  
  minMargin             Decimal? 
  maxMargin             Decimal? 
  isActive              Boolean  @default(true)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([corridor, adType])
  @@map("pricing_configs")
}
