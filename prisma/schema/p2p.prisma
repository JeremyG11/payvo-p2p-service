model FiatCryptoRate {
  id                 String          @id @default(uuid())
  source             String
  fiatCurrency       FiatCurrency
  cryptoCurrency     CryptoCurrency   @default(USDT)
  rateType           RateType
  paymentMethod      String?         
  rawRate            Decimal         
  adjustedRate       Decimal?        
  marginPercentage   Decimal?            
  volumeAvailable    Decimal?        
  minLimit           Decimal?        
  maxLimit           Decimal?        
  adId               String?         
  isActive           Boolean         @default(true)
  
  fetchedAt          DateTime        @default(now())       
  expiresAt          DateTime?       
  createdAt          DateTime        @default(now())       
  updatedAt          DateTime        @updatedAt           

  @@index([source])
  @@index([fiatCurrency, cryptoCurrency])
  @@index([fiatCurrency, cryptoCurrency, paymentMethod, rateType])
  @@index([source, fetchedAt])
}

model PaymentAccount {
  id              String               @id @default(uuid())
  userId          String
  type            PaymentMethodType
  currency        FiatCurrency
  details         Json                 @db.JsonB

  cbe             CBE?
  mpesaKenya      MPesaKenya?

  createdAt       DateTime             @default(now())   @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt        @db.Timestamptz(6)

  userLinks       UserPaymentMethod[]

  @@index([type])
}

model UserPaymentMethod {
  id                String           @id @default(uuid())
  userId            String
  paymentAccountId  String
  isDefault         Boolean          @default(false)

  createdAt         DateTime         @default(now())   @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt        @db.Timestamptz(6)

  account           PaymentAccount   @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)

  /// prevent duplicate links:
  @@unique([userId, paymentAccountId])
  @@index([userId])
}

model MPesaKenya {
  accountId     String           @id
  phoneNumber   String           @unique
  createdAt     DateTime         @default(now())   @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt        @db.Timestamptz(6)

  account       PaymentAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("mpesa_kenya")
}

model CBE {
  accountId     String           @id
  accountNumber String           @unique
  createdAt     DateTime         @default(now())   @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt        @db.Timestamptz(6)

  account       PaymentAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("cbe_bank")
}