model AdsOnPaymentMethods {
  adId                  String
  paymentMethodId       String

  ad                    Ad                     @relation(fields: [adId], references: [id])
  paymentMethod         SupportedPaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@id([adId, paymentMethodId])
}

model Ad {
  id                      String                @id @default(uuid())
  adId                    String                @unique
  agentId                 String
  fiatCryptoRateId        String   
  title                   String?
  terms                   String?
  availableAmount         Decimal               @db.Decimal(36, 18)
  minLimitFiat            Decimal               @db.Decimal(18, 2)
  maxLimitFiat            Decimal               @db.Decimal(18, 2)
  status                  AdStatus              @default(ACTIVE)

  createdAt               DateTime              @default(now())
  updatedAt               DateTime @updatedAt

  agent                   Agent                 @relation(fields: [agentId], references: [id], onDelete: Restrict)
  fiatCryptoRate          FiatCryptoRate        @relation(fields: [fiatCryptoRateId], references: [id], onDelete: Restrict)
  orders                  Order[]
  acceptedPaymentMethods  AdsOnPaymentMethods[]

  @@index([agentId, status])
}