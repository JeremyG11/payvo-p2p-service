{
  "name": "payvo-p2p-service",
  "version": "1.0.0",
  "description": "Payvo Node.js P2P Service for Peer-to-Peer Transactions",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node -r module-alias/register src/server.ts",
    "start": "node -r module-alias/register dist/server.js",
    "build": "tsup",
    "test": "vitest",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "npx prisma generate",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate",
    "prisma": "npx prisma",
    "db:push": "npx prisma db push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-c8": "^0.33.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.11.1",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@payvo/kafka": "git+https://github.com/JeremyG11/payvo-kafka.git#main",
    "@payvo/logger": "git+https://github.com/JeremyG11/payvo-logger.git#main",
    "@payvo/redis": "git+https://github.com/JeremyG11/payvo-redis.git#main",
    "@prisma/client": "6.11.1",
    "@types/express": "^5.0.1",
    "axios": "^1.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "module-alias": "^2.2.3",
    "nanoid": "^5.1.5",
    "node-cron": "^4.1.0",
    "nodemailer": "^6.10.0",
    "redis": "^5.8.2",
    "tsup": "^8.5.0",
    "twilio": "^5.7.0",
    "winston": "^3.17.0",
    "zod": "^4.0.17"
  },
  "_moduleAliases": {
    "@": "./src"
  }
}
