{
  "name": "@payvo/p2p-service",
  "version": "1.0.0",
  "description": "Payvo Node.js P2P Service for Peer-to-Peer Transactions and Management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx -r module-alias/register src/server.ts",
    "start": "node -r module-alias/register dist/server.js",
    "build": "tsup && npm run test:coverage ",
    "test": "vitest",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "npx prisma generate",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate",
    "prisma": "npx prisma",
    "db:push": "npx prisma db push",
    "seed:pricing": "ts-node -r module-alias/register src/scripts/seeds/seed-pricing-configs.ts",
    "seed:ads": "ts-node -r module-alias/register src/scripts/seeds/seed-ads.ts"
  },
  "keywords": [],
  "author": "Gatwech Tap Nguth",
  "license": "ISC",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^6.4.20",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "3.2.4",
    "nodemon": "^3.1.10",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^3.14.0"
  },
  "dependencies": {
    "@payvo/kafka": "git+https://github.com/JeremyG11/payvo-kafka.git#main",
    "@payvo/redis": "git+https://github.com/JeremyG11/payvo-redis.git#main",
    "@payvo/utils": "git+https://github.com/JeremyG11/payvo-utils.git#main",
    "@prisma/client": "^6.19.0",
    "axios": "^1.12.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "module-alias": "^2.2.3",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "payvo-auth": "git+https://github.com/JeremyG11/payvo-auth.git#main",
    "twilio": "^5.10.2",
    "winston": "^3.18.3"
  },
  "_moduleAliases": {
    "@": "./src"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
